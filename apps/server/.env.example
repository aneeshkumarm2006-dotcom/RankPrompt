# apps/server/.env — names only, never commit values (ops/env-vars.md has every default).
# Copy to .env for local overrides. `pnpm dev` works without a .env at all: development
# defaults APP_URL to http://localhost:5173 and starts an in-memory MongoDB.
# In production every integration key below is required (env.ts refuses to boot otherwise).

# --- Core
NODE_ENV=
PORT=
APP_URL=
RUN_HTTP=
RUN_WORKER=
INSTANCE_ID=
LOG_LEVEL=
SHUTDOWN_GRACE_MS=

# --- Database (empty locally = in-memory replica set; production DB name: promptverse_v2)
MONGODB_URI=

# --- Auth
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL_DAYS=
GOOGLE_CLIENT_ID=

# --- AI providers (FAKE_PROVIDERS=true returns canned answers, for tests and local dev)
FAKE_PROVIDERS=
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=
OPENAI_EXTRACT_MODEL=
OPENAI_UTILITY_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_EFFORT=
CLAUDE_WEB_SEARCH_MAX_USES=
CLAUDE_REFUSAL_FALLBACK=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOAD_ASYNC_AIO=
PROVIDER_LIMITS=
PROVIDER_DAILY_CAP_USD=
MAX_INFLIGHT_PER_WORKSPACE=
WORKER_CONCURRENCY=

# --- Stripe (existing account, TEST keys in development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_TOPUP_50=
STRIPE_PRICE_TOPUP_100=
STRIPE_PRICE_TOPUP_200=
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Email (log driver by default; resend only when RESEND_API_KEY is set)
EMAIL_DRIVER=
RESEND_API_KEY=
EMAIL_FROM=

# --- Optional
SENTRY_DSN=

# --- Production only: same value as EDGE_PROXY_SECRET in the Vercel project (ops/go-live.md)
EDGE_PROXY_SECRET=
