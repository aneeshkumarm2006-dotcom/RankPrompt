# apps/web/.env — names only, never commit values. Build-time (Vite) variables.
# There is no API URL: the app always calls same-origin /api (D-018).
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=

# Vercel runtime only (read by middleware.ts, not by Vite; local dev uses the Vite proxy):
# API_ORIGIN=https://<render service>.onrender.com and EDGE_PROXY_SECRET (ops/go-live.md).
API_ORIGIN=
EDGE_PROXY_SECRET=
