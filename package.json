{
  "name": "promptverse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:dev": "node scripts/db-dev.mjs",
    "db:backup": "pnpm --filter @pv/server --silent backup",
    "engine": "pnpm --filter @pv/engine --silent cli",
    "admin": "pnpm --filter @pv/server --silent admin",
    "soak": "pnpm --filter @pv/server --silent soak",
    "loadtest": "pnpm --filter @pv/server --silent loadtest",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p e2e",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test -c e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
